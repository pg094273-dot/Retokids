    function playBeep(freq = 520, type = 'sine', duration = 0.15) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    function playFanfare() {
      setTimeout(() => playBeep(440, 'triangle', 0.12), 0);
      setTimeout(() => playBeep(554, 'triangle', 0.12), 120);
      setTimeout(() => playBeep(659, 'triangle', 0.15), 240);
      setTimeout(() => playBeep(880, 'triangle', 0.35), 380);
    }

    /* ============================================================
       LÓGICA DE RETOS
    ============================================================ */
    function setFilter(filter, el) {
      document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
      el.classList.add('active');
      currentFilter = filter;
      nextChallenge();
    }

    function getFilteredRetos() {
      if (currentFilter === 'todos') return RETOS;
      return RETOS.filter(r => r.place === 'todos' || r.place === currentFilter);
    }

    function nextChallenge() {
      const list = getFilteredRetos();
      const randomIndex = Math.floor(Math.random() * list.length);
      const reto = list[randomIndex];

      playBeep(400, 'sine', 0.08);

      const card = document.getElementById('card');
      card.style.animation = 'none';
      void card.offsetWidth; // re-trigger animation
      card.style.animation = 'popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)';

      document.getElementById('c-category').textContent = reto.cat;
      document.getElementById('c-place').textContent = reto.place === 'casa' ? '🏠 En Casa' : (reto.place === 'calle' ? '🌳 En Calle' : '🌍 Donde Sea');
      document.getElementById('c-emoji').textContent = reto.emoji;
      document.getElementById('c-title').textContent = reto.title;
      document.getElementById('c-desc').textContent = reto.desc;
    }

    /* ============================================================
       JUGADORES Y PUNTUACIÓN
    ============================================================ */
    function savePlayers() {
      localStorage.setItem('retokids_players', JSON.stringify(players));
      renderPlayers();
      renderQuickAwardButtons();
    }

    function renderPlayers() {
      const listEl = document.getElementById('players-list');
      listEl.innerHTML = '';

      // Ordenar por puntuación descendente
      const sorted = [...players].sort((a,b) => b.score - a.score);

      sorted.forEach(p => {
        const item = document.createElement('div');
        item.className = 'player-card';

        const avatarContent = p.isCustomImg 
          ? `<img src="${p.avatar}" alt="${p.name}">`
          : p.avatar;

        item.innerHTML = `
          <div class="player-info">
            <div class="player-avatar">${avatarContent}</div>
            <div>
              <div class="player-name">${p.name}</div>
              <small style="color:#64748b; font-weight:700;">${p.score} puntos</small>
            </div>
          </div>
          <div class="score-controls">
            <button class="btn-circle btn-minus" onclick="modifyScore(${p.id}, -1)">-</button>
            <div class="score-badge">${p.score}</div>
            <button class="btn-circle btn-plus" onclick="modifyScore(${p.id}, 1)">+</button>
            <button style="border:none;background:transparent;font-size:1.1rem;margin-left:6px;cursor:pointer;" onclick="deletePlayer(${p.id})">🗑️</button>
          </div>
        `;
        listEl.appendChild(item);
      });
    }

    function renderQuickAwardButtons() {
      const quickBar = document.getElementById('quick-players');
      quickBar.innerHTML = '';

      if (players.length === 0) {
        quickBar.innerHTML = '<span style="font-size:0.85rem;color:#94a3b8;">¡Agrega jugadores en la pestaña Puntos!</span>';
        return;
      }

      players.forEach(p => {
        const btn = document.createElement('button');
        btn.className = 'quick-player-btn';
        
        const avatarMini = p.isCustomImg 
          ? `<img src="${p.avatar}" style="width:20px;height:20px;border-radius:50%;object-fit:cover;">`
          : p.avatar;

        btn.innerHTML = `${avatarMini} <span>${p.name}</span>`;
        btn.onclick = () => {
          modifyScore(p.id, 1);
          triggerConfetti();
          playFanfare();
          setTimeout(nextChallenge, 800);
        };
        quickBar.appendChild(btn);
      });
    }

    function modifyScore(id, delta) {
      const p = players.find(x => x.id === id);
      if (p) {
        p.score = Math.max(0, p.score + delta);
        if (delta > 0) playBeep(650, 'sine', 0.1);
        savePlayers();
      }
    }

    function deletePlayer(id) {
      if (confirm("¿Seguro que deseas eliminar a este participante?")) {
        players = players.filter(x => x.id !== id);
        savePlayers();
      }
    }

    function pickEmoji(emoji, el) {
      customImageBase64 = null;
      currentEmoji = emoji;
      document.querySelectorAll('.avatar-option').forEach(e => e.classList.remove('selected'));
      el.classList.add('selected');
    }

    function handleImageUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(event) {
        // Reducir tamaño de la imagen para no llenar LocalStorage
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          canvas.width = 120;
          canvas.height = 120;
          ctx.drawImage(img, 0, 0, 120, 120);
          customImageBase64 = canvas.toDataURL('image/jpeg', 0.8);
          document.querySelectorAll('.avatar-option').forEach(el => el.classList.remove('selected'));
          alert("¡Foto seleccionada correctamente!");
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }

    function addPlayer() {
      const nameInput = document.getElementById('player-name');
      const name = nameInput.value.trim();
      if (!name) {
        alert("Escribe el nombre del participante");
        return;
      }

      const newPlayer = {
        id: Date.now(),
        name: name,
        avatar: customImageBase64 ? customImageBase64 : currentEmoji,
        isCustomImg: !!customImageBase64,
        score: 0
      };

      players.push(newPlayer);
      nameInput.value = '';
      customImageBase64 = null;
      savePlayers();
      playBeep(700, 'triangle', 0.2);
    }

    /* ============================================================
       NAVEGACIÓN ENTRE PESTAÑAS
    ============================================================ */
    function switchView(viewName) {
      playBeep(350, 'sine', 0.05);
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));

      if (viewName === 'retos') {
        document.querySelectorAll('.tab-btn')[0].classList.add('active');
        document.getElementById('view-retos').classList.add('active');
      } else {
        document.querySelectorAll('.tab-btn')[1].classList.add('active');
        document.getElementById('view-jugadores').classList.add('active');
      }
    }

    /* ============================================================
       EFECTO CONFETI NATIVO (SIN LIBRERÍAS)
    ============================================================ */
    const canvas = document.getElementById('confetti');
    const ctx = canvas.getContext('2d');
    let particles = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function triggerConfetti() {
      particles = [];
      const colors = ['#6366f1', '#f59e0b', '#10b981', '#ec4899', '#3b82f6'];
      for (let i = 0; i < 60; i++) {
        particles.push({
          x: canvas.width / 2,
          y: canvas.height / 2,
          r: Math.random() * 6 + 4,
          dx: (Math.random() - 0.5) * 12,
          dy: (Math.random() - 0.7) * 14,
          color: colors[Math.floor(Math.random() * colors.length)],
          tilt: Math.random() * 10,
          tiltAngle: 0,
          tiltAngleInc: (Math.random() * 0.07) + 0.05
        });
      }
      requestAnimationFrame(renderConfetti);
    }

    function renderConfetti() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      let alive = false;
      particles.forEach(p => {
        p.tiltAngle += p.tiltAngleInc;
        p.y += (Math.cos(p.tiltAngle) + 1 + p.r / 2) / 2 + 3;
        p.x += p.dx;
        p.dx *= 0.98;
        if (p.y < canvas.height) alive = true;

        ctx.beginPath();
        ctx.lineWidth = p.r / 2;
        ctx.strokeStyle = p.color;
        ctx.moveTo(p.x + p.tilt + p.r / 4, p.y);
        ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r / 4);
        ctx.stroke();
      });

      if (alive) requestAnimationFrame(renderConfetti);
      else ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    // Inicialización
    document.getElementById('challenge-counter').textContent = `+${RETOS.length} Retos`;
    savePlayers();
    nextChallenge();
  </script>
</body>
</html>